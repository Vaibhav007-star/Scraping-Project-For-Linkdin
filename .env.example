# ==============================================================================
# LINKEDIN SHOWCASE AUTOMATION PIPELINE CONFIGURATION
# ==============================================================================

# 1. Google Gemini API (100% Free Tier via Google AI Studio)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. LinkedIn Official REST API
# Create a free app at: https://www.linkedin.com/developers/apps
# Scopes needed: w_member_social, openid, profile
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth_access_token_here

# Your LinkedIn Member URN or Organization URN (e.g., urn:li:person:AbCdEf1234)
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_URN_HERE

# 3. Optional Vercel Account Token (for live deployed projects)
# Get your token at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# 3. Execution Safety Controls
# DRY_RUN=True stages videos and generated posts in ready_to_post/ for human review.
# Set DRY_RUN=False only when you are ready to publish directly to LinkedIn.
DRY_RUN=True

# 4. Video Editing & High-Definition / 4K Parameters
TRIM_START_SEC=2.0
SPEED_FACTOR=1.18
RECORD_DURATION_SEC=40
RECORDING_RESOLUTION=1080p   # Options: 1080p (Full HD 1920x1080), 2k (2560x1440), 4k (3840x2160)
RECORDING_DEVICE_SCALE=1.5   # 1.5 or 2.0 for Retina subpixel crispness
VIDEO_BITRATE=12M            # Broadcast quality bitrate
VIDEO_CRF=18                 # Visually lossless constant rate factor
